{
  "manifest_version": 3,
  "name": "Stackcutify - AI Subscription Tracker Pro",
  "version": "1.2.3",
  "description": "Local-first AI subscription tracker — Pro $2.84/mo, founding price locked forever. Unlimited tools, exports, cancel drafts. No bank connection. PayPal Plan P-6HT714478R159110WNLBOW4Q",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stackcutify Pro $2.84/mo",
    "default_icon": {"16": "icons/icon16.png","48": "icons/icon48.png","128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png","48": "icons/icon48.png","128": "icons/icon128.png"},
  "permissions": ["storage","activeTab","scripting","downloads"],
  "host_permissions": ["https://*.openai.com/*","https://*.chatgpt.com/*","https://*.claude.ai/*","https://*.anthropic.com/*","https://*.perplexity.ai/*","https://*.midjourney.com/*","https://*.cursor.com/*","https://*.cursor.sh/*","https://stackcutify.vercel.app/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://*.openai.com/*","https://*.chatgpt.com/*","https://*.claude.ai/*","https://*.anthropic.com/*","https://*.perplexity.ai/*","https://*.midjourney.com/*","https://*.cursor.com/*","https://*.cursor.sh/*"],"js": ["content.js"],"run_at": "document_idle"}]
}
