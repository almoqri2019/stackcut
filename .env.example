# Optional server-signed entitlement configuration. Never use a public example token.
STACKCUT_PRO_SECRET=
STACKCUT_PRO_LICENSE_ALLOWLIST=

# PayPal subscription verification. Use real server-side credentials only in the
# hosting provider's secret environment settings, not in source control.
STACKCUT_PAYPAL_ENV=live
STACKCUT_PAYPAL_CLIENT_ID=replace-with-server-side-client-id
STACKCUT_PAYPAL_CLIENT_SECRET=replace-with-server-side-client-secret
STACKCUT_PAYPAL_PLAN_ID=replace-with-paypal-plan-id
